{
  "manifest_version": 3,
  "name": "WebRTC Live Monitor",
  "version": "1.3.0",
  "description": "Zeigt Peer Connections sowie aktive WebRTC-Audio-, Video- und Bildschirmfreigabekanäle pro Tab an.",
  "minimum_chrome_version": "111",
 "permissions": [
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/service-worker.js"
  },
   "icons": {
    "128": "icon/webrtc-live-monitor-icon-128(1).png"
  },
  "action": {
    "default_title": "WebRTC Live Monitor"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/rtp-stats.js",
        "src/main-world.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ]
}
